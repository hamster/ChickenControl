#!/bin/sh
### BEGIN INIT INFO
# Provides:          chickengate
# Required-Start:    $local_fs $syslog
# Required-Stop:     $local_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Chicken door hardware daemon (GPIO + scheduler)
# Description:       Manages GPIO relay control and solar scheduling for
#                    chicken coop doors.  Accepts commands from chickenctl
#                    via Unix socket.
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DESC="Chicken door hardware daemon"
NAME=chickengate
DAEMON=/usr/local/bin/chickengate
DAEMON_USER=chickenhw
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log
SCRIPTNAME=/etc/init.d/$NAME

[ -r /etc/default/$NAME ] && . /etc/default/$NAME

. /lib/init/vars.sh
. /lib/lsb/init-functions

do_start() {
    start-stop-daemon --start --quiet \
        --pidfile "$PIDFILE" --make-pidfile \
        --background --no-close \
        --chuid "$DAEMON_USER" \
        --startas "$DAEMON" \
        --test > /dev/null || return 0

    start-stop-daemon --start --quiet \
        --pidfile "$PIDFILE" --make-pidfile \
        --background --no-close \
        --chuid "$DAEMON_USER" \
        --startas "$DAEMON" \
        -- $DAEMON_ARGS >> "$LOGFILE" 2>&1 || return 1
}

do_stop() {
    start-stop-daemon --stop --quiet \
        --retry=TERM/30/KILL/5 \
        --pidfile "$PIDFILE" \
        --name "$NAME"
    RETVAL=$?
    [ "$RETVAL" -eq 0 ] && rm -f "$PIDFILE"
    return "$RETVAL"
}

case "$1" in
    start)
        log_daemon_msg "Starting $DESC" "$NAME"
        do_start
        case "$?" in
            0) log_end_msg 0 ;;
            1) log_end_msg 1 ;;
        esac
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        do_stop
        case "$?" in
            0|1) log_end_msg 0 ;;
            2)   log_end_msg 1 ;;
        esac
        ;;
    restart)
        log_daemon_msg "Restarting $DESC" "$NAME"
        do_stop
        case "$?" in
            0|1)
                do_start
                case "$?" in
                    0) log_end_msg 0 ;;
                    *) log_end_msg 1 ;;
                esac
                ;;
            *)
                log_end_msg 1
                ;;
        esac
        ;;
    status)
        status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" && exit 0 || exit $?
        ;;
    *)
        echo "Usage: $SCRIPTNAME {start|stop|restart|status}" >&2
        exit 3
        ;;
esac

exit 0
