[Unit]
Description=Chicken door HTTPS proxy (Home Assistant interface)
After=network.target chickengate.service
Requires=chickengate.service

[Service]
Type=simple
ExecStart=/usr/local/bin/chickenctl
Restart=on-failure
RestartSec=5s
WorkingDirectory=/tmp
PrivateTmp=true

StandardOutput=journal
StandardError=journal

# Runs as chickennet — network access only, no GPIO
User=chickennet

# Needs to read TLS cert/key and config; no write access needed
ReadOnlyPaths=/etc/chickendoor
# Needs to connect to the chickengate socket in /run
ReadWritePaths=/run
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
